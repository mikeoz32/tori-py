{
  "realm": "tori-space",
  "enabled": true,
  "displayName": "Tori Space (local demo)",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "tenant-id",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "tori-space-api-audience",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "tori-space-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": { "included.client.audience": "tori-space-api", "id.token.claim": "false", "access.token.claim": "true" }
        }
      ]
    }
  ],
  "roles": {
    "client": {
      "tori-space-web": [
        { "name": "employee", "description": "May browse resources and create own bookings.", "composite": false, "clientRole": true },
        { "name": "facilities-admin", "description": "May administer resources within a tenant.", "composite": false, "clientRole": true }
      ]
    }
  },
  "clients": [
    {
      "clientId": "tori-space-web",
      "name": "Tori Space web",
      "enabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": { "access.token.claim": "true", "id.token.claim": "true" }
        },
        {
          "name": "tori-space-web client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "tori-space-web",
            "multivalued": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ],
      "publicClient": true,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "redirectUris": [
        "http://localhost:8010/web/",
        "http://127.0.0.1:8010/web/",
        "http://localhost:8010/live/workplace",
        "http://127.0.0.1:8010/live/workplace"
      ],
      "webOrigins": ["http://localhost:8010", "http://127.0.0.1:8010"],
      "defaultClientScopes": ["profile", "email", "roles", "tenant-id", "tori-space-api-audience"],
      "optionalClientScopes": []
    },
    {
      "clientId": "tori-space-api",
      "name": "Tori Space API audience",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "north.employee", "email": "north.employee@example.test", "firstName": "North", "lastName": "Employee", "enabled": true, "emailVerified": true,
      "attributes": { "tenant_id": ["tenant-north"] },
      "clientRoles": { "tori-space-web": ["employee"] },
      "credentials": [{ "type": "password", "value": "north-employee-demo-only", "temporary": false }]
    },
    {
      "username": "north.admin", "email": "north.admin@example.test", "firstName": "North", "lastName": "Admin", "enabled": true, "emailVerified": true,
      "attributes": { "tenant_id": ["tenant-north"] },
      "clientRoles": { "tori-space-web": ["employee", "facilities-admin"] },
      "credentials": [{ "type": "password", "value": "north-admin-demo-only", "temporary": false }]
    },
    {
      "username": "south.employee", "email": "south.employee@example.test", "firstName": "South", "lastName": "Employee", "enabled": true, "emailVerified": true,
      "attributes": { "tenant_id": ["tenant-south"] },
      "clientRoles": { "tori-space-web": ["employee"] },
      "credentials": [{ "type": "password", "value": "south-employee-demo-only", "temporary": false }]
    },
    {
      "username": "south.admin", "email": "south.admin@example.test", "firstName": "South", "lastName": "Admin", "enabled": true, "emailVerified": true,
      "attributes": { "tenant_id": ["tenant-south"] },
      "clientRoles": { "tori-space-web": ["employee", "facilities-admin"] },
      "credentials": [{ "type": "password", "value": "south-admin-demo-only", "temporary": false }]
    }
  ]
}
